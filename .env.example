# --- PostgreSQL (Pruebas locales) ---
POSTGRES_USER=fde_user
POSTGRES_PASSWORD=change_me_local_password
POSTGRES_DB=fde_local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://fde_user:change_me_local_password@localhost:5432/fde_local

# --- APIs de Modelos / LLMs (Fases posteriores) ---
OPENAI_API_KEY=sk-placeholder-replace-me
ANTHROPIC_API_KEY=sk-ant-placeholder-replace-me
GEMINI_API_KEY=placeholder-replace-me

